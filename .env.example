# ============================================================
# Dive on Wide Core Configuration
# Copy this file to `.env` and adjust it — `.env` is git-ignored.
#   cp .env.example .env
# NEVER put real API keys into this example file.
# ============================================================

# Port the Dive on Wide interface listens on (http://localhost:PORT)
PORT=3000

# Network address to listen on. 0.0.0.0 lets other devices in your network
# connect (they still need an access key). 127.0.0.1 = this machine only.
HOST=0.0.0.0

# Address of your local Ollama instance
# - Same machine:                  http://localhost:11434
# - Ollama on another machine:     http://192.168.x.x:11434
# - From inside Docker (macOS/Win) http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Default model (must exist in `ollama list`)
DEFAULT_MODEL=qwen2.5-coder:14b

# Fallback model for a step that ran out of memory (empty = the smallest
# installed model of at least 2 GB). Used once per step, and always noted in
# the run protocol — never a silent switch.
AUSWEICH_MODELL=

# Was diese Instanz an fremde Gerüste (Claude Code, andere Agenten) herausgibt:
# aus (Standard) | urteil | zusammenfassung | alles  — siehe docs/AUSGANG.md
AUSGANG_STUFE=aus

# Nachtschicht (Rhythmus): Vorschlaege automatisch ins Gedaechtnis uebernehmen?
# 0 = nur vorschlagen (Standard), 1 = bis zu 5 Notizen je Nacht uebernehmen
KONSOLIDIERUNG_UEBERNEHMEN=0

# Context window & creativity
NUM_CTX=16384
TEMPERATURE=0.7

# --- Code sandbox ---
# Code execution for the coding agent.
# OFF by default, and deliberately so: this runs generated code on your
# machine as your user. The workspace folder and the time limit are a working
# boundary, not a security boundary (see SECURITY.md). Turn it on when you
# have decided to, not because a default decided for you.
SANDBOX_ENABLED=0
# Run inside a Docker container instead of directly (1 = on, requires Docker)
SANDBOX_DOCKER=0
SANDBOX_IMAGE=python:3.11-slim

# --- Second Brain ---
# Automatically fold chat history into the knowledge base.
# OFF by default: what happens to your conversations is your decision, not a
# preset. Switch it on in the settings once you want it.
BRAIN_AUTOSYNC=0

# --- Stability ---
# How many model-heavy background runs may work in parallel.
# Higher = faster with many tasks, but more load on Ollama.
MAX_PARALLEL_RUNS=3

# --- Web access ---
# Allow fetching internal/local addresses (e.g. your own LAN wiki).
# Default 0 = blocked; protects against unintended access to local services (SSRF).
ALLOW_LOCAL_FETCH=0

# --- Browser agent (optional, requires: pip3 install browser-use ollama) ---
# Take over your own Chrome (with your logins and extensions):
# start Chrome once with --remote-debugging-port=9222, then put the URL here.
# Empty = Dive on Wide starts its own clean browser.
BROWSER_CDP_URL=

# Browser window visible (0) or headless/faster (1)
BROWSER_HEADLESS=0
# Maximum number of click/read steps a single job may take
BROWSER_MAX_STEPS=25
# Dedicated model for the browser agent (empty = DEFAULT_MODEL)
BROWSER_MODEL=
# Use the installed system Chrome instead of Playwright's Chromium
BROWSER_USE_SYSTEM_CHROME=0
# Custom Chrome profile directory (only relevant without a CDP URL)
BROWSER_PROFILE=

# --- Web search (optional but strongly recommended) --------------------------
# The keyless default search (Mojeek -> DuckDuckGo -> Wikipedia) works, but is
# the weakest link for serious research. A free Tavily key takes 2 minutes and
# fixes it at the root. Keys are configured in the UI
# (Settings -> Web bridge) and stored in the database, not here.
